{
  "description": "darkforge: model-guard for Agent calls",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/model-guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
